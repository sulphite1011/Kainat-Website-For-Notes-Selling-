# MongoDB Atlas Connection URI (Replace with your actual MongoDB Atlas cluster credentials)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kainat_notes_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://kainat_user:password123@cluster0.mongodb.net/kainat_notes_hub?retryWrites=true&w=majority

# Clerk Google Authentication Publishable Key (From dashboard.clerk.com -> API Keys)
# Both CLERK_PUBLISHABLE_KEY and VITE_CLERK_PUBLISHABLE_KEY are automatically supported
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Port
PORT=3000
