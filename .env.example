# Kainat Notes Hub - Environment Configuration
# Deployment targets: Vercel, Cloudflare Pages, Node.js

# Clerk Google Authentication Publishable Key (From dashboard.clerk.com -> API Keys)
# Both CLERK_PUBLISHABLE_KEY and VITE_CLERK_PUBLISHABLE_KEY are automatically detected
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Port (Used for local/server mode, default: 3000)
PORT=3000
